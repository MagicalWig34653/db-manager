{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MagicalWig34653/db-manager/main/contracts/export/result-v1.schema.json",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only.",
  "title": "DB Manager Ergebnisexport 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "truncated",
    "columns",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/sql_scope"
        },
        {
          "$ref": "#/$defs/page_scope"
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/cell"
        }
      }
    }
  },
  "$defs": {
    "sql_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "sql_result"
        }
      }
    },
    "page_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset",
        "page_size",
        "has_more"
      ],
      "properties": {
        "kind": {
          "const": "table_page"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "text",
                "integer",
                "decimal",
                "float",
                "boolean",
                "binary",
                "timestamp"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
